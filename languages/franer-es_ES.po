#, php-format
msgid "%s submission collected."
msgid_plural "%s submissions collected."
msgstr[0] "%s envío recogido."
msgstr[1] "%s envíos recogidos."

msgid "View submissions"
msgstr "Ver envíos"

msgid "Export JSON"
msgstr "Exportar JSON"

msgid "View overview"
msgstr "Ver resumen"

msgid "Renders all submissions with the Submission View HTML template."
msgstr "Representa todos los envíos con la plantilla HTML de la vista de envíos."

msgid "Need help creating an activity? The Help page includes a ready-to-use AI prompt and the full JavaScript contract."
msgstr "¿Necesitas ayuda para crear una actividad? La página de Ayuda incluye un prompt de IA listo para usar y el contrato completo de JavaScript."

msgid "Open Help"
msgstr "Abrir la Ayuda"

msgid "Back to submissions"
msgstr "Volver a los envíos"

msgid "Print"
msgstr "Imprimir"

msgid "Activity"
msgstr "Actividad"

msgid "Total submissions"
msgstr "Total de envíos"

#. translators: %s: maximum number of submissions delivered to the view.
#, php-format
msgid "This activity has more submissions than can be rendered at once. The view received the %s most recent submissions."
msgstr "Esta actividad tiene más envíos de los que se pueden representar a la vez. La vista recibió los %s envíos más recientes."

msgid "View JSON"
msgstr "Ver JSON"

msgid "Submissions JSON payload"
msgstr "Datos JSON de los envíos"

msgid "Rendered overview"
msgstr "Resumen representado"

msgid "Rendered submissions overview"
msgstr "Resumen de envíos representado"

msgid "Submission deleted."
msgstr "Envío eliminado."

msgid "Submission updated."
msgstr "Envío actualizado."

msgid "The submitted JSON is not a valid object. No changes were saved."
msgstr "El JSON enviado no es un objeto válido. No se han guardado cambios."

msgid "Filter by activity"
msgstr "Filtrar por actividad"

msgid "— Select an activity —"
msgstr "— Selecciona una actividad —"

msgid "Filter"
msgstr "Filtrar"

msgid "Export all submissions (JSON)"
msgstr "Exportar todos los envíos (JSON)"

msgid "Choose an activity to view its submissions."
msgstr "Elige una actividad para ver sus envíos."

msgid "No submissions found for this activity yet."
msgstr "Todavía no hay envíos para esta actividad."

#. translators: %s: number of submissions.
#, php-format
msgid "%s submission"
msgid_plural "%s submissions"
msgstr[0] "%s envío"
msgstr[1] "%s envíos"

msgid "&laquo;"
msgstr "&laquo;"

msgid "&raquo;"
msgstr "&raquo;"

