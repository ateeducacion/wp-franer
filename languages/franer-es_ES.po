#. Plugin Name of the plugin
msgid "Franer"
msgstr "Franer"

#. Plugin URI of the plugin
msgid "https://github.com/ateeducacion/wp-franer"
msgstr "https://github.com/ateeducacion/wp-franer"

#. Description of the plugin
msgid "Franer is a secure environment to publish AI-generated forms. It renders self-contained AI-generated HTML activities inside a sandboxed iframe and collects users' JSON submissions safely server-side."
msgstr "Franer es un entorno seguro para publicar formularios generados por IA. Renderiza actividades HTML autocontenidas generadas por IA dentro de un iframe aislado (sandbox) y recopila de forma segura los envíos JSON de los usuarios en el servidor."

#. Author of the plugin
msgid "Área de Tecnología Educativa"
msgstr "Área de Tecnología Educativa"

#. Author URI of the plugin
msgid "https://www3.gobiernodecanarias.org/medusa/ecoescuela/ate/"
msgstr "https://www3.gobiernodecanarias.org/medusa/ecoescuela/ate/"

