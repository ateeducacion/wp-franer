<?xml version="1.0"?>
<ruleset name="Franer">
	<description>WordPress Coding Standards ruleset for the Franer plugin.</description>

	<!-- Scan the whole plugin directory by default. -->
	<file>.</file>

	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Show progress and use colors. -->
	<arg value="ps"/>

	<!-- Strip the file paths down to the relevant bit. -->
	<arg name="basepath" value="."/>

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>

	<!-- Exclude paths that should not be linted. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/examples/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<!-- Use the WordPress standard. -->
	<rule ref="WordPress"/>

	<!-- Only report errors, not warnings. -->
	<arg name="warning-severity" value="0"/>

	<!-- Verify that the text domain is set correctly. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="franer"/>
			</property>
		</properties>
	</rule>

	<!-- Verify that prefixes are used for globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="franer"/>
				<element value="Franer"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum supported WP version for sniffs that check this. -->
	<config name="minimum_wp_version" value="6.0"/>

	<!-- Check for PHP cross-version compatibility. -->
	<config name="testVersion" value="8.0-"/>
</ruleset>
